{
  "version": 1,
  "title": "Live Deck — demo",
  "theme": { "background": "#10131a", "foreground": "#f4f1ea", "accent": "#ff7a45", "muted": "#9aa3b2", "surface": "#1b2130" },
  "slides": [
    {
      "id": "portada",
      "notes": "Da la bienvenida. Pide que escaneen el QR antes de empezar.",
      "elements": [
        { "id": "kicker", "type": "text", "box": { "x": 0.07, "y": 0.14, "w": 0.5, "h": 0.06 }, "text": "PRESENTACIÓN EN VIVO", "style": { "fontSize": 30, "fontWeight": 700, "color": "accent", "font": "mono" } },
        { "id": "titulo", "type": "text", "box": { "x": 0.07, "y": 0.22, "w": 0.52, "h": 0.36 }, "text": "Presentar ya no es hablarle a una pared", "style": { "fontSize": 104, "fontWeight": 800, "font": "display", "lineHeight": 1.02 } },
        { "id": "bajada", "type": "text", "box": { "x": 0.07, "y": 0.64, "w": 0.48, "h": 0.12 }, "text": "Escanea el código, elige tu nombre (o entra anónimo) y sigue la charla desde tu celular.", "style": { "fontSize": 36, "color": "muted", "lineHeight": 1.3 } },
        { "id": "qr", "type": "qr", "box": { "x": 0.64, "y": 0.16, "w": 0.29, "h": 0.68 }, "style": { "background": "text", "color": "background" } }
      ]
    },
    {
      "id": "agenda",
      "notes": "Cada punto aparece con 'siguiente'. Prueba el focus sobre el punto 2.",
      "elements": [
        { "id": "h", "type": "text", "box": { "x": 0.07, "y": 0.1, "w": 0.86, "h": 0.14 }, "text": "Lo que vas a poder hacer", "style": { "fontSize": 80, "fontWeight": 800, "font": "display" } },
        { "id": "p1", "type": "text", "box": { "x": 0.07, "y": 0.32, "w": 0.4, "h": 0.22 }, "text": "01\nSeguir al ponente en vivo o explorar por tu cuenta", "fragment": 1, "style": { "fontSize": 40, "lineHeight": 1.25, "background": "surface", "radius": 24, "padding": 36 } },
        { "id": "p2", "type": "text", "box": { "x": 0.53, "y": 0.32, "w": 0.4, "h": 0.22 }, "text": "02\nResponder preguntas y ver si acertaste", "fragment": 2, "style": { "fontSize": 40, "lineHeight": 1.25, "background": "surface", "radius": 24, "padding": 36 } },
        { "id": "p3", "type": "text", "box": { "x": 0.07, "y": 0.6, "w": 0.4, "h": 0.22 }, "text": "03\nReaccionar sin interrumpir", "fragment": 3, "style": { "fontSize": 40, "lineHeight": 1.25, "background": "surface", "radius": 24, "padding": 36 } },
        { "id": "p4", "type": "text", "box": { "x": 0.53, "y": 0.6, "w": 0.4, "h": 0.22 }, "text": "04\nChatear con texto y stickers", "fragment": 4, "style": { "fontSize": 40, "lineHeight": 1.25, "background": "surface", "radius": 24, "padding": 36 } }
      ]
    },
    {
      "id": "arquitectura",
      "notes": "Usa el zoom sobre el servidor.",
      "elements": [
        { "id": "h", "type": "text", "box": { "x": 0.07, "y": 0.08, "w": 0.86, "h": 0.12 }, "text": "Cómo viaja cada clic", "style": { "fontSize": 72, "fontWeight": 800, "font": "display" } },
        { "id": "ponente", "type": "text", "box": { "x": 0.07, "y": 0.42, "w": 0.22, "h": 0.2 }, "text": "Ponente", "style": { "fontSize": 44, "fontWeight": 700, "align": "center", "valign": "middle", "background": "accent", "color": "on-accent", "radius": 28 } },
        { "id": "flecha1", "type": "shape", "shape": "line", "box": { "x": 0.3, "y": 0.52, "w": 0.09, "h": 0 }, "style": { "stroke": "muted", "strokeWidth": 6 } },
        { "id": "servidor", "type": "text", "box": { "x": 0.39, "y": 0.36, "w": 0.22, "h": 0.32 }, "text": "Servidor\n\nestado único\nde la sesión", "style": { "fontSize": 38, "align": "center", "valign": "middle", "background": "surface", "radius": 28, "lineHeight": 1.2 } },
        { "id": "flecha2", "type": "shape", "shape": "line", "box": { "x": 0.61, "y": 0.52, "w": 0.09, "h": 0 }, "style": { "stroke": "muted", "strokeWidth": 6 } },
        { "id": "publico", "type": "text", "box": { "x": 0.71, "y": 0.42, "w": 0.22, "h": 0.2 }, "text": "Público", "style": { "fontSize": 44, "fontWeight": 700, "align": "center", "valign": "middle", "background": "text", "color": "background", "radius": 28 } },
        { "id": "nota", "type": "text", "box": { "x": 0.07, "y": 0.8, "w": 0.86, "h": 0.08 }, "text": "Menos de 200 ms de punta a punta en una red normal.", "style": { "fontSize": 32, "color": "muted", "align": "center" } }
      ]
    },
    {
      "id": "quiz-vivo",
      "layout": "quiz",
      "notes": "Resultados en vivo: todos ven cómo se mueven las barras.",
      "elements": [],
      "quiz": {
        "question": "¿Cuál es el principal enemigo de una buena presentación?",
        "options": ["Demasiado texto", "Ninguna interacción", "Mal audio", "Diapositivas feas"],
        "correctIndex": 1,
        "display": "live"
      }
    },
    {
      "id": "quiz-secreto",
      "layout": "quiz",
      "notes": "Respuesta secreta hasta que la reveles. Tiene 30 segundos.",
      "elements": [],
      "quiz": {
        "question": "¿Cuántos minutos de atención sostenida tiene en promedio una audiencia antes de distraerse?",
        "options": ["2", "10", "25", "45"],
        "correctIndex": 1,
        "display": "secret",
        "timerSec": 30
      }
    },
    {
      "id": "pregunta-abierta",
      "layout": "ask",
      "notes": "Las respuestas iguales se agrupan con ×N. Pide que activen la autocorrección del teclado.",
      "elements": [],
      "ask": {
        "question": "¿Qué palabra describe tu semana?"
      }
    },
    {
      "id": "cierre",
      "notes": "Agradece y finaliza la sesión para descargar el resumen.",
      "elements": [
        { "id": "gracias", "type": "text", "box": { "x": 0.07, "y": 0.3, "w": 0.86, "h": 0.26 }, "text": "Gracias", "style": { "fontSize": 200, "fontWeight": 800, "font": "display", "align": "center", "valign": "middle" } },
        { "id": "sub", "type": "text", "box": { "x": 0.07, "y": 0.6, "w": 0.86, "h": 0.1 }, "text": "Tus respuestas no se guardan después de cerrar la sesión.", "style": { "fontSize": 36, "color": "muted", "align": "center" } }
      ]
    }
  ]
}
