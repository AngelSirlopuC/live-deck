{
  "version": 1,
  "title": "Tema propio — ejemplo claro",
  "theme": {
    "preset": "editorial",
    "mode": "light",
    "background": "#fbf7f0",
    "foreground": "#1d1a16",
    "accent": "#c2410c",
    "muted": "#6b6259",
    "surface": "#f1e9dc",
    "fonts": { "display": "Fraunces", "body": "Instrument Sans" },
    "card": { "radius": 6, "border": "hairline", "shadow": "none" },
    "heading": { "weight": 800, "uppercase": false, "tracking": -0.02 },
    "art": { "kind": "glow" },
    "pattern": "none",
    "palette": ["#c2410c", "#0f766e", "#7c3aed", "#b45309"]
  },
  "slides": [
    {
      "id": "portada",
      "notes": "Ejemplo de tema creado desde el prompt: \"estilo revista, claro, con acento óxido\".",
      "elements": [
        { "id": "kicker", "type": "text", "box": { "x": 0.07, "y": 0.14, "w": 0.5, "h": 0.06 }, "text": "TEMA PROPIO · MODO CLARO", "style": { "fontSize": 30, "fontWeight": 700, "font": "mono", "color": "#c2410c" } },
        { "id": "titulo", "type": "text", "box": { "x": 0.07, "y": 0.22, "w": 0.52, "h": 0.36 }, "text": "Una sala con luz pide un fondo claro", "style": { "fontSize": 104, "fontWeight": 800, "font": "display", "lineHeight": 1.02 } },
        { "id": "bajada", "type": "text", "box": { "x": 0.07, "y": 0.64, "w": 0.48, "h": 0.12 }, "text": "Colores, fuentes, tarjetas y paleta salen del prompt, no de un preset fijo.", "style": { "fontSize": 36, "color": "#6b6259", "lineHeight": 1.3 } },
        { "id": "qr", "type": "qr", "box": { "x": 0.64, "y": 0.16, "w": 0.29, "h": 0.68 } }
      ]
    },
    {
      "id": "piezas",
      "notes": "Cada tarjeta usa el estilo de tarjeta del tema: radio 6, borde fino, sin sombra.",
      "elements": [
        { "id": "h", "type": "text", "box": { "x": 0.07, "y": 0.1, "w": 0.86, "h": 0.14 }, "text": "Lo que define el tema", "style": { "fontSize": 80, "fontWeight": 800, "font": "display" } },
        { "id": "c1", "type": "text", "box": { "x": 0.07, "y": 0.32, "w": 0.4, "h": 0.22 }, "text": "Colores\nFondo crema, texto casi negro y un acento óxido.", "fragment": 1, "style": { "fontSize": 38, "lineHeight": 1.25, "card": true } },
        { "id": "c2", "type": "text", "box": { "x": 0.53, "y": 0.32, "w": 0.4, "h": 0.22 }, "text": "Fuentes\nFraunces para títulos, Instrument Sans para el texto.", "fragment": 2, "style": { "fontSize": 38, "lineHeight": 1.25, "card": true } },
        { "id": "c3", "type": "text", "box": { "x": 0.07, "y": 0.6, "w": 0.4, "h": 0.22 }, "text": "Tarjetas\nEsquinas suaves y borde fino, sin sombra.", "fragment": 3, "style": { "fontSize": 38, "lineHeight": 1.25, "card": true } },
        { "id": "c4", "type": "text", "box": { "x": 0.53, "y": 0.6, "w": 0.4, "h": 0.22 }, "text": "Paleta\nCuatro colores para gráficos, el acento primero.", "fragment": 4, "style": { "fontSize": 38, "lineHeight": 1.25, "card": true } }
      ]
    },
    {
      "id": "paleta",
      "notes": "El gráfico toma la paleta del tema en orden.",
      "elements": [
        { "id": "h", "type": "text", "box": { "x": 0.07, "y": 0.1, "w": 0.86, "h": 0.14 }, "text": "La paleta llega a los gráficos", "style": { "fontSize": 72, "fontWeight": 800, "font": "display" } },
        { "id": "dona", "type": "chart", "kind": "donut", "box": { "x": 0.07, "y": 0.3, "w": 0.4, "h": 0.6 }, "data": [{ "label": "Charlas", "value": 5 }, { "label": "Talleres", "value": 3 }, { "label": "Paneles", "value": 2 }, { "label": "Demos", "value": 1 }] },
        { "id": "barras", "type": "chart", "kind": "bar", "box": { "x": 0.53, "y": 0.3, "w": 0.4, "h": 0.6 }, "unit": "%", "data": [{ "label": "Ene", "value": 40 }, { "label": "Feb", "value": 65 }, { "label": "Mar", "value": 52 }, { "label": "Abr", "value": 80 }] }
      ]
    },
    {
      "id": "cierre",
      "elements": [
        { "id": "gracias", "type": "text", "box": { "x": 0.07, "y": 0.3, "w": 0.86, "h": 0.26 }, "text": "Gracias", "style": { "fontSize": 200, "fontWeight": 800, "font": "display", "align": "center", "valign": "middle" } },
        { "id": "sub", "type": "text", "box": { "x": 0.07, "y": 0.6, "w": 0.86, "h": 0.1 }, "text": "Ajusta cualquier detalle en el panel Diseño del editor.", "style": { "fontSize": 36, "color": "#6b6259", "align": "center" } }
      ]
    }
  ]
}
