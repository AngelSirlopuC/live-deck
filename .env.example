# Live Deck configuration. Copy to `.env` and edit; `.env` is git-ignored.
# Never commit real values.

# REQUIRED in production. Protects session creation and the deck list
# (sent by the admin page as the `x-admin-key` header). The server refuses to
# start without it when NODE_ENV=production. Generate one with:
#   openssl rand -base64 32
ADMIN_KEY=

# Public URL used in join links and QR codes, e.g. https://deck.example.com
# Set it when running behind a reverse proxy. Empty = derived from the request.
PUBLIC_BASE_URL=

# Set to 1 ONLY when a trusted reverse proxy (e.g. Caddy) sits in front and is
# the only way to reach the app. Then X-Forwarded-For/-Proto/-Host are trusted
# for client IPs (rate limits) and link building. Leave empty when exposed
# directly, otherwise clients can spoof their IP.
TRUST_PROXY=

# Comma-separated exact origins allowed to open WebSockets, e.g.
# https://deck.example.com. Empty = same host as the request (usually right).
ALLOWED_ORIGINS=

# Optional. Enables GIPHY stickers in chat (G/PG only, proxied by the server).
# Get a key at https://developers.giphy.com/ . Empty = stickers disabled.
GIPHY_API_KEY=

# Listen address inside the container. The image defaults are fine; change the
# host side of the port mapping in compose.yaml instead.
# PORT=8787
# HOST=0.0.0.0

# Deck directory. The image uses /app/decks (bind-mounted from ./decks).
# DECKS_DIR=/app/decks
